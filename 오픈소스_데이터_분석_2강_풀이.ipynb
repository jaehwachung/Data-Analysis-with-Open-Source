//6번문제
city_population = {
    '서울': 957, '부산': 339, '인천': 294, '대구': 242, '광주': 145, '대전': 147,
    '울산': 114, '세종': 36, '수원': 115, '창원': 103, '고양': 105, '용인': 108, '성남': 94
}

# 인구 200만명 이상의 도시 리스트
large_cities = { city: pop for city, pop in city_population.items() if pop >=200 }
print(large_cities)

# 인구 300만 이상 및 이름에 '산'이 포함된 도시 리스트
large_short_name_cities = { city: pop for city, pop in city_population.items() if pop >= 300 and '산'in city}
print(large_short_name_cities)

//문자열 형식화
//1번문제
name = '홍길동'
age = 30
salary = 3500000
tax_rate = 0.1

# C 스타일 문자열 포매팅
# 이름, 나이, 월급 출력
basic_format = '이름: %s, 나이: %d, 월급: %d' % (name, age, salary)
# 직원이름, 나이, 세후 월급 출력
index_format = '직원이름: %s, 나이: %d, 세후월급: %d' % (name, age, salary*(1-tax_rate))

# 직원이름, 나이, 월급, 세금, 실수령액 추력
keyword_format = '직원이름: %s, 나이: %d, 월급: %d, 세금: %d, 실수령액: %d' % (name, age, salary, salary*tax_rate, salary*(1-tax_rate))

print(basic_format)
print(index_format)
print(keyword_format)

//2번문제
name = '홍길동'
age = 30
salary = 3500000
tax_rate = 0.1

# str.format 문자열 포매팅
# 이름, 나이, 월급 출력
basic_foramt = '이름: {}, 나이: {}, 월급: {}원'.format(name, age, salary)
# 직원이름, 나이, 세후 월급 출력

index_format = '직원이름: {}, 나이: {}, 세후 월급: {}'.format(name, age, int(salary*(1-tax_rate)))
# 직원이름, 나이, 월급, 세금, 실수령액 추력
keyword_format = '직원이름: {}, 나이: {}, 월급: {}, 세금: {}, 실수령액: {}'.format(name, age, salary, int(salary*tax_rate), int(salary*(1-tax_rate)))

print(basic_format)
print(index_format)
print(keyword_format)

